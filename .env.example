# Copie com ./setup.sh: gera senhas aleatorias e cria .env com permissao 600.
# Um nome UNICO por projeto; tambem identifica volumes e rede.
COMPOSE_PROJECT_NAME=wordpress
WORDPRESS_PORT=8080
# Antes de instalar o WordPress, troque pelo subdominio HTTPS definitivo.
SITE_URL=http://localhost:8080
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=CHANGE_ME_GENERATE_WITH_SETUP
MYSQL_ROOT_PASSWORD=CHANGE_ME_GENERATE_WITH_SETUP
